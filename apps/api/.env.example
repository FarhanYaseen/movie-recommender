# Copy to apps/api/.env (or set these in the repo-root .env — the app reads
# both, with this file's location taking precedence). Real environment
# variables always override either file.

# --- Required ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/movie_recommender
# Generate with: openssl rand -hex 32. The app refuses to start in production
# (APP_ENV=production) with the insecure default.
JWT_SECRET=change-me-generate-a-real-one
VOYAGE_API_KEY=your_voyage_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Demo users (seeded only when ENABLE_DEMO_SEED=true) ---
ENABLE_DEMO_SEED=true
DEMO_USER_A_EMAIL=alice@example.com
DEMO_USER_A_PASSWORD=alice-demo-password
DEMO_USER_B_EMAIL=bob@example.com
DEMO_USER_B_PASSWORD=bob-demo-password

# --- Optional (defaults shown) ---
# APP_ENV=development            # set to "production" to enforce a real JWT_SECRET
# JWT_EXPIRES_MIN=60
# ANTHROPIC_MODEL=claude-opus-5-5
# VOYAGE_MODEL=voyage-3
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_RPM=3                # Voyage free tier; raise after adding billing
# EMBEDDING_TIMEOUT_S=30
# EMBEDDING_BATCH_SIZE=32
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150
# MAX_UPLOAD_BYTES=2097152
# AGENT_MAX_TOOL_ROUNDS=3
# CHAT_MAX_OUTPUT_TOKENS=1024
# CHAT_TIMEOUT_S=120
# USER_DAILY_MESSAGE_LIMIT=200
# RETRIEVAL_TOP_K=8
# RETRIEVAL_SIMILARITY_FLOOR=0.25
# HISTORY_MAX_MESSAGES=20
# WORKER_ENABLED=true
# WORKER_POLL_INTERVAL_S=1.0
