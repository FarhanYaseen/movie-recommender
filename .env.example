# Copy this to .env and fill in your values.
#
# This file covers the LEGACY NODE API (src/) plus the keys Docker Compose
# forwards to all services. Each app documents its own variables:
#   - FastAPI backend:  apps/api/.env.example (the backend also reads this
#     root .env, so keys here are enough for Compose and simple local runs)
#   - Next.js frontend: apps/web/.env.example

# Application
NODE_ENV=development
PORT=3000

# Voyage AI API (for embeddings — shared by legacy API and backend)
# Get your key at https://dash.voyageai.com/
VOYAGE_API_KEY=your_voyage_api_key_here

# Anthropic API (for grounded answers — shared by legacy /ask and backend chat)
# Get your key at https://console.anthropic.com/ — make sure the key belongs
# to an org with credits. Without it, /ask returns 503; everything else works.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional model override (default: claude-opus-5-5)
# Cheaper options for demo traffic: claude-sonnet-5-5, claude-haiku-4-5
# ANTHROPIC_MODEL=claude-opus-5-5

# PostgreSQL connection (legacy Node API). These defaults match the Compose
# stack; for a non-Docker local Postgres, set DB_USER to a role that exists
# (often your macOS username, with an empty DB_PASSWORD).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=movie_recommender
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=10

# Embedding provider pacing (legacy Node API)
# Free tier is 3 requests/minute; raise after adding a Voyage payment method
EMBEDDING_RPM=3
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_MAX_RETRIES=3

# Compose-forwarded backend values (full reference: apps/api/.env.example)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/movie_recommender
JWT_SECRET=dev-only-change-me
ENABLE_DEMO_SEED=true
DEMO_USER_A_EMAIL=alice@example.com
DEMO_USER_A_PASSWORD=alice-demo-password
DEMO_USER_B_EMAIL=bob@example.com
DEMO_USER_B_PASSWORD=bob-demo-password

# Frontend (full reference: apps/web/.env.example)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Catalog retrieval evals (npm run evals)
# EVAL_HIT5_THRESHOLD=0.8

# Live document-retrieval evals (evals/run-doc-evals.py; opt-in, real API calls)
# RUN_LIVE_EVALS=true
# EVAL_API_BASE=http://localhost:8000
# EVAL_EMAIL=alice@example.com
# EVAL_PASSWORD=alice-demo-password
