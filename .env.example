# Copy this to .env and fill in your values

# Application
NODE_ENV=development
PORT=3000

# Voyage AI API (for embeddings)
# Get your key at https://dash.voyageai.com/
VOYAGE_API_KEY=your_voyage_api_key_here

# Anthropic API (for grounded answers via /ask)
# Get your key at https://console.anthropic.com/
# Without it, /ask returns 503 while all other endpoints keep working
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional model override (default: claude-opus-5-5)
# Cheaper options for demo traffic: claude-sonnet-5-5, claude-haiku-4-5
# ANTHROPIC_MODEL=claude-opus-5-5

# PostgreSQL connection (legacy Node API)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=movie_recommender
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=10

# Embedding provider pacing (legacy Node API)
# Free tier is 3 requests/minute; raise after adding a Voyage payment method
EMBEDDING_RPM=3
EMBEDDING_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# FastAPI AI backend (apps/api) — see docs/contracts/ai-api.md
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/movie_recommender
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_MIN=60
VOYAGE_MODEL=voyage-3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_S=30
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_UPLOAD_BYTES=2097152
AGENT_MAX_TOOL_ROUNDS=3
CHAT_MAX_OUTPUT_TOKENS=1024
CHAT_TIMEOUT_S=120
USER_DAILY_MESSAGE_LIMIT=200

# Local demo users (seeded only when ENABLE_DEMO_SEED=true)
ENABLE_DEMO_SEED=true
DEMO_USER_A_EMAIL=alice@example.com
DEMO_USER_A_PASSWORD=alice-demo-password
DEMO_USER_B_EMAIL=bob@example.com
DEMO_USER_B_PASSWORD=bob-demo-password

# ---------------------------------------------------------------------------
# Next.js frontend (apps/web)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
