{
  "name": "movie-recommender",
  "version": "1.0.0",
  "description": "Semantic movie recommender with grounded RAG answers \u2014 pgvector + Voyage AI embeddings + Claude",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "NODE_ENV=development node src/index.js",
    "seed": "node src/scripts/seed.js",
    "evals": "node evals/run-evals.js",
    "lint": "eslint src/ evals/",
    "lint:fix": "eslint src/ evals/ --fix",
    "format": "prettier --write src/",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "docker:seed": "docker compose exec app node src/scripts/seed.js",
    "test": "jest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "swagger-ui-express": "^5.0.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "eslint": "^8.57.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.2.5",
    "supertest": "^7.3.1"
  },
  "keywords": [
    "pgvector",
    "embeddings",
    "movie-recommender",
    "vector-search",
    "semantic-search",
    "ai",
    "recommendation-engine",
    "nodejs",
    "postgresql",
    "voyage-ai",
    "rag",
    "anthropic",
    "claude",
    "sse"
  ],
  "author": "Farhan Yaseen <farhan.yaseen.se@gmail.com> (https://farhanyaseen.netlify.app/)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FarhanYaseen/movie-recommender.git"
  },
  "bugs": {
    "url": "https://github.com/FarhanYaseen/movie-recommender/issues"
  },
  "homepage": "https://github.com/FarhanYaseen/movie-recommender#readme",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
